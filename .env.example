# 复制为 .env 仅供本地参考；真实值请在 EdgeOne Pages 控制台 → 项目设置 → 环境变量 中配置（类型选择 Secret）。
# 本文件不应提交真实密钥。

# 1. ZenMux 控制台创建的 API Key（用于大模型调用）
ZENMUX_API_KEY=

# 2. 自定义访问门禁口令（防止接口被外部盗刷）
ACCESS_TOKEN=

# 3. 可选插件密钥（按需在 EdgeOne 控制台配置为 Secret）
ANYSEARCH_API_KEY=
FIRECRAWL_API_KEY=
FINNHUB_API_KEY=
OPENALEX_API_KEY=
NEWSAPI_KEY=
SEMANTIC_SCHOLAR_KEY=
GITHUB_TOKEN=
